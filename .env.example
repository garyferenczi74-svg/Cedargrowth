# Supabase URL (public, safe to expose in the browser bundle)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase secret key (server only, never expose). Used by the reserve route to
# insert reservations with full privileges. Rotate if leaked.
SUPABASE_SECRET_KEY=

# Resend (server only)
RESEND_API_KEY=
RESERVATION_ALERT_TO=
RESERVATION_ALERT_FROM=

# ---------------------------------------------------------------------------
# Practice (CG Prompt 09E). The public marketing site reads NONE of these. With
# all of them unset, Practice reports itself unavailable and the public site
# builds and deploys normally. Set PRACTICE_ENABLED last, only after the
# migration is applied and Auth with MFA is configured.
# ---------------------------------------------------------------------------

# Supabase publishable key (public, browser safe). Used by the signed-in
# employee client. Without it, employees cannot sign in; the public site is
# unaffected. This is NOT the secret key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Turns Practice on. Requires the Supabase URL, the secret key, and the
# publishable key above, plus the migration applied and Auth configured.
# Without it (or with it not 'true'), Practice renders its unavailable door.
PRACTICE_ENABLED=

# Preview mode. Renders the Practice structure against the empty mock with no
# auth and no records, for reviewing the interface before provisioning. Never
# set this in production alongside PRACTICE_ENABLED.
PRACTICE_PREVIEW=
