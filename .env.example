# Supabase URL (public, safe to expose in the browser bundle)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase secret key (server only, never expose). Used by the reserve route to
# insert reservations with full privileges. Rotate if leaked.
SUPABASE_SECRET_KEY=

# Resend (server only)
RESEND_API_KEY=
RESERVATION_ALERT_TO=
RESERVATION_ALERT_FROM=
